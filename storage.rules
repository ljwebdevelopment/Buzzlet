// Buzzlet Storage Security Rules
// - Allow users to upload their own profile photos.
// - Public read so profiles can display everywhere.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profilePhotos/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
